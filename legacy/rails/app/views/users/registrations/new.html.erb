<div class="auth-card">
  <h1 class="sr-only">Criar conta no Fluxo</h1>
  <%= render "shared/auth_brand" %>
  <div class="auth-tabs" aria-label="Acesso à conta">
    <%= link_to "Entrar", new_user_session_path, class: "auth-tab" %>
    <%= link_to "Criar conta", new_user_registration_path, class: "auth-tab active", aria: { current: "page" } %>
  </div>
  <%= render "shared/form_errors", object: resource %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <div class="auth-field">
      <%= f.label :name, "Nome completo", class: "auth-label" %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Seu nome", class: "auth-input" %>
    </div>
    <div class="auth-field">
      <%= f.label :email, "E-mail", class: "auth-label" %>
      <%= f.email_field :email, autocomplete: "email", required: true, placeholder: "seu@email.com", class: "auth-input" %>
    </div>
    <div class="auth-field">
      <%= f.label :password, "Senha", class: "auth-label" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, minlength: @minimum_password_length, class: "auth-input", aria: { describedby: "password-help" } %>
      <p class="auth-help" id="password-help">Use pelo menos <%= @minimum_password_length %> caracteres.</p>
    </div>
    <div class="auth-field">
      <%= f.label :password_confirmation, "Confirmar senha", class: "auth-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "auth-input" %>
    </div>
    <%= f.submit "Criar conta grátis", class: "auth-submit" %>
  <% end %>
  <p class="auth-footer-link">Já tem conta? <%= link_to "Entrar", new_user_session_path %></p>
</div>
