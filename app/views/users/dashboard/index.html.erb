<%= render "shared/page_header",
           eyebrow: "Visão geral",
           title: "Olá, #{current_user.name.presence || current_user.email}",
           description: "Acompanhe sua vida financeira em um único lugar.",
           action_text: "Nova transação",
           action_path: new_users_transaction_path %>


<!-- RESUMO DO MÊS -->

<div class="metrics-grid">

  <%= render "shared/metric_card",
             label: "Saldo do mês",
             value: number_to_currency(
               @balance_cents / 100.0,
               unit: "R$ ",
               separator: ",",
               delimiter: "."
             ),
             subtitle: "Receitas menos gastos",
             variant: @balance_cents.negative? ? "danger" : "success" %>


  <%= render "shared/metric_card",
             label: "Receitas",
             value: number_to_currency(
               @income_cents / 100.0,
               unit: "R$ ",
               separator: ",",
               delimiter: "."
             ),
             subtitle: "Entradas no mês",
             variant: "success" %>


  <%= render "shared/metric_card",
             label: "Gastos",
             value: number_to_currency(
               @expense_cents / 100.0,
               unit: "R$ ",
               separator: ",",
               delimiter: "."
             ),
             subtitle: "Saídas no mês",
             variant: "danger" %>

</div>


<!-- RESUMO ANUAL -->

<%= render "shared/panel",
           title: "Resumo de #{@reference_date.year}",
           description: "Resultado financeiro acumulado no ano." do %>

  <div class="metrics-grid">

    <%= render "shared/metric_card",
               label: "Receitas no ano",
               value: number_to_currency(
                 @year_income_cents / 100.0,
                 unit: "R$ ",
                 separator: ",",
                 delimiter: "."
               ),
               variant: "success" %>

    <%= render "shared/metric_card",
               label: "Gastos no ano",
               value: number_to_currency(
                 @year_expense_cents / 100.0,
                 unit: "R$ ",
                 separator: ",",
                 delimiter: "."
               ),
               variant: "danger" %>

    <%= render "shared/metric_card",
               label: "Saldo anual",
               value: number_to_currency(
                 @year_balance_cents / 100.0,
                 unit: "R$ ",
                 separator: ",",
                 delimiter: "."
               ),
               variant: @year_balance_cents.negative? ? "danger" : "success" %>

  </div>

<% end %>


<!-- ANÁLISES -->

<div class="analytics-grid">

  <%= render "shared/panel",
             title: "Receitas e despesas por mês",
             description: "Movimentação financeira durante #{@reference_date.year}." do %>

    <div class="table-responsive">

      <table class="data-table">

        <thead>
          <tr>
            <th>Mês</th>
            <th>Receitas</th>
            <th>Despesas</th>
            <th>Saldo</th>
          </tr>
        </thead>

        <tbody>

          <% @monthly_summary.each do |month| %>

            <tr>

              <td>
                <%= month[:month_name].capitalize %>
              </td>

              <td class="data-table__success">
                <%= number_to_currency(
                      month[:income_cents] / 100.0,
                      unit: "R$ ",
                      separator: ",",
                      delimiter: "."
                    ) %>
              </td>

              <td class="data-table__danger">
                <%= number_to_currency(
                      month[:expense_cents] / 100.0,
                      unit: "R$ ",
                      separator: ",",
                      delimiter: "."
                    ) %>
              </td>

              <td>
                <%= number_to_currency(
                      month[:balance_cents] / 100.0,
                      unit: "R$ ",
                      separator: ",",
                      delimiter: "."
                    ) %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% end %>


  <%= render "shared/panel",
             title: "Gastos por categoria",
             description: "Despesas acumuladas no ano." do %>

    <% if @category_summary.any? %>

      <div class="resource-list">

        <% @category_summary.each do |category_name, amount_cents| %>

          <%= render "shared/resource_item",
                     icon: "🏷️",
                     title: category_name,
                     value: number_to_currency(
                       amount_cents / 100.0,
                       unit: "R$ ",
                       separator: ",",
                       delimiter: "."
                     ) %>

        <% end %>

      </div>

    <% else %>

      <%= render "shared/empty_state",
                 icon: "🏷️",
                 title: "Nenhuma despesa categorizada",
                 description: "As despesas por categoria aparecerão aqui." %>

    <% end %>

  <% end %>

</div>


<!-- TRANSAÇÕES RECENTES -->

<%= render "shared/panel",
           title: "Transações recentes",
           description: "Últimos lançamentos registrados." do %>

  <% if @recent_transactions.any? %>

    <div class="resource-list">

      <% @recent_transactions.each do |transaction| %>

        <% details = [] %>

        <% details << transaction.category.name if transaction.category.present? %>

        <% details << transaction.credit_card.name if transaction.credit_card.present? %>

        <% details << transaction.occurred_on.strftime("%d/%m/%Y") %>

        <%= render "shared/resource_item",
                   icon: transaction.income? ? "↑" : "↓",
                   title: transaction.description,
                   description: details.join(" · "),
                   value: "#{transaction.income? ? '+' : '-'} #{transaction.formatted_amount}" %>

      <% end %>

    </div>

  <% else %>

    <%= render "shared/empty_state",
               icon: "💳",
               title: "Nenhuma transação cadastrada",
               description: "Registre uma receita ou despesa para começar.",
               action_text: "Criar primeira transação",
               action_path: new_users_transaction_path %>

  <% end %>

<% end %>